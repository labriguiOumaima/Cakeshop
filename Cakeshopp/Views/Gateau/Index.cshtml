@model List<project.Models.Gateau>

@{
    ViewData["Title"] = "Cake Shop - Gâteaux sur Mesure";
}

<style>
    :root {
        --rose: #E8989A;
        --lilas: #D4C5E2;
        --blanc: #FFFFFF;
        --gris-texte: #4A4A4A;
        --lilas-bg: #F5F0FA;
    }

    .hero-section {
        min-height: 80vh;
        display: flex;
        align-items: center;
        padding: 4rem 0;
        background: linear-gradient(135deg, rgba(232, 152, 154, 0.05) 0%, rgba(212, 197, 226, 0.05) 100%);
    }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-size: 3.5rem;
        font-weight: 400;
        color: var(--rose);
        line-height: 1.2;
        margin-bottom: 1.5rem;
        letter-spacing: 3px;
    }

    .hero-subtitle {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.1rem;
        font-weight: 300;
        color: var(--gris-texte);
        letter-spacing: 1px;
        max-width: 500px;
        line-height: 1.8;
    }

    .hero-image {
        width: 100%;
        max-width: 600px;
        height: 420px;
        object-fit: cover;
        border-radius: 20px;
        box-shadow: 0 25px 80px rgba(232, 152, 154, 0.2);
    }

    .hero-placeholder {
        height: 420px;
        width: 100%;
        max-width: 600px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

    .products-section {
        padding: 5rem 0;
        background: linear-gradient(135deg, rgba(232, 152, 154, 0.08) 0%, rgba(212, 197, 226, 0.08) 100%);
    }

    .section-title {
        font-family: 'Playfair Display', serif;
        color: var(--rose);
        font-size: 3.5rem;
        font-weight: 400;
        letter-spacing: 4px;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .section-subtitle {
        color: var(--gris-texte);
        font-size: 1.1rem;
        opacity: 0.85;
        text-align: center;
        margin-bottom: 4rem;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
    }

    /* Product Cards */
    .product-card {
        background: var(--blanc);
        border: 2px solid var(--lilas);
        border-radius: 15px;
        overflow: hidden;
        transition: all 0.4s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 8px 20px rgba(232, 152, 154, 0.12);
    }

        .product-card:hover {
            transform: translateY(-10px);
            border-color: var(--rose);
            box-shadow: 0 20px 50px rgba(232, 152, 154, 0.25);
        }

    .product-card-image {
        width: 100%;
        height: 400px;
        overflow: hidden;
        position: relative;
        background: linear-gradient(135deg, rgba(232, 152, 154, 0.05) 0%, rgba(212, 197, 226, 0.05) 100%);
    }

    .carousel-images {
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .carousel-item {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        transition: opacity 0.8s ease-in-out;
    }

        .carousel-item.active {
            opacity: 1;
        }

        .carousel-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .product-card:hover .carousel-item img {
        transform: scale(1.1);
    }

    .product-card-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(232, 152, 154, 0.1) 0%, rgba(212, 197, 226, 0.1) 100%);
    }

    .product-card-content {
        padding: 3rem 2.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .product-card-title {
        font-family: 'Playfair Display', serif;
        color: var(--rose);
        font-size: 2.2rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        letter-spacing: 2px;
    }

    .product-card-description {
        color: var(--gris-texte);
        font-size: 1.05rem;
        line-height: 1.8;
        margin-bottom: 2.5rem;
        flex-grow: 1;
    }

    .product-card-button {
        background-color: var(--rose);
        color: var(--blanc);
        border: none;
        padding: 1rem 2.5rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.95rem;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        text-decoration: none;
        width: fit-content;
        border-radius: 8px;
    }

        .product-card-button:hover {
            background-color: #d97b7d;
            color: var(--blanc);
            transform: translateX(5px);
            box-shadow: 0 6px 20px rgba(232, 152, 154, 0.3);
        }

    @@media (max-width: 991px) {
        .hero-title {
            font-size: 2.5rem;
        }

        .section-title {
            font-size: 2.5rem;
        }

        .product-card {
            margin-bottom: 2rem;
        }

        .product-card-image {
            height: 300px;
        }
    }
</style>

<div class="container-fluid px-4">
    <!-- Hero Section -->
    <div class="hero-section">
        <div class="row align-items-center w-100">
            <div class="col-lg-6">
                <h1 class="hero-title">
                    WE WILL BRING<br>
                    YOUR IDEAS TO LIFE
                </h1>
                <p class="hero-subtitle">
                    Step into a world of mouthwatering confections that will make your celebrations truly unforgettable
                </p>
                <a href="@Url.Action("Index", "Custom")" class="btn btn-primary btn-lg mt-4" style="padding: 1rem 2.5rem; font-size: 1rem; letter-spacing: 2px;">
                    Custom Made
                </a>
            </div>
            <div class="col-lg-6 text-center">
                <img src="@Url.Content("~/images/accueil/cake.webp")"
                     alt="Custom cake"
                     class="hero-image"
                     onerror="this.parentElement.querySelector('.hero-placeholder').style.display='flex'; this.style.display='none';">
                <div class="hero-placeholder" style="display: none;">
                    <i class="bi bi-cake2" style="font-size: 10rem; color: var(--rose); opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Products Section -->
<section class="products-section">
    <div class="container">
        <h2 class="section-title">OUR PRODUCTS</h2>
        <p class="section-subtitle">
            We will listen to all your wishes, pay attention to important little things and bring your ideas to life
        </p>

        <div class="row g-4">
            <!-- CUSTOM MADE Card -->
            <div class="col-lg-6" id="custom-section">
                <div class="product-card">
                    <div class="product-card-image">
                        <img src="@Url.Content("~/images/accueil/cake.webp")" alt="gateau" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                        <div class="product-card-placeholder" style="display: none;">
                            <i class="bi bi-palette" style="font-size: 5rem; color: var(--rose); opacity: 0.4;"></i>
                        </div>
                    </div>
                    <div class="product-card-content">
                        <h3 class="product-card-title">CUSTOM MADE</h3>
                        <p class="product-card-description">
                            Créez le gâteau de vos rêves selon vos envies. Notre équipe transformera vos idées en une œuvre d'art comestible, avec une attention particulière aux détails et une qualité exceptionnelle.
                        </p>
                        <a href="mailto:contact@cakeshop.com" class="product-card-button">
                            Contactez-nous <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- SHOP Card avec Carrousel -->
            <div class="col-lg-6">
                <div class="product-card">
                    <div class="product-card-image">
                        @if (Model != null && Model.Any())
                        {
                            <div class="carousel-images">
                                @foreach (var gateau in Model.Take(4))
                                {
                                    @if (!string.IsNullOrEmpty(gateau.ImagePath))
                                    {
                                        <div class="carousel-item">
                                            <img src="@Url.Content("~/images/gateaux/" + gateau.ImagePath)" alt="@gateau.Nom">
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="product-card-placeholder">
                                <i class="bi bi-shop" style="font-size: 5rem; color: var(--rose); opacity: 0.4;"></i>
                            </div>
                        }
                    </div>
                    <div class="product-card-content">
                        <h3 class="product-card-title">SHOP</h3>
                        <p class="product-card-description">
                            Découvrez notre sélection de délicieux gâteaux prêts à commander. Des créations uniques qui raviront vos papilles et émerveilleront vos invités pour toutes vos occasions spéciales.
                        </p>
                        <a href="@Url.Action("Catalogue", "Gateau")" class="product-card-button">
                            Voir le catalogue <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const carousels = document.querySelectorAll('.carousel-images');

        carousels.forEach(carousel => {
            const items = carousel.querySelectorAll('.carousel-item');
            let currentIndex = 0;

            if (items.length > 0) {
                items[0].classList.add('active');

                setInterval(() => {
                    items[currentIndex].classList.remove('active');
                    currentIndex = (currentIndex + 1) % items.length;
                    items[currentIndex].classList.add('active');
                }, 4000);
            }
        });
    });
</script>
